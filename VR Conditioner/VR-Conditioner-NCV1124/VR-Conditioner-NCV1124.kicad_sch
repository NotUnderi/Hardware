	(text "Datasheet values are pretty close to real life so we can use a 15k resistor for R1 and R2 and 17k8 for Radj.(because this is what my local store has in stock)"
		(exclude_from_sim no)
		(at 111.506 131.826 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2e6ebe8a-9ac5-4c96-b44d-c201340f3150")
	)
	(text "Some random VR sensor datasheet says that their coil is\nInductance @ 1 kHz: 360 mH ± 10%\nResistance @ 25°C: 850 Ohm ± 10%\nReactance @ 1kHz = ~2262 Ohm\nAssuming this is about the same for most sensors in a car.\n"
		(exclude_from_sim no)
		(at 94.742 118.618 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4938d43d-b2d5-4822-a717-ad51f2852400")
	)
	(text "LPF (R1+C1 and R2+C2) has to be calculated for each usecase and VR-sensor\n\n1 nF results into 10.61kHz cutoff\n\nToyota 36-1 crank wheel and 7000rpm equates to roughly 4000Hz"
		(exclude_from_sim no)
		(at 53.086 55.626 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "eba7efae-88ed-42b1-b764-2b931fcea86b")
	)
