	(gr_text "SoFar:\n+ under 20x20mm & single sided for ‘Letter’ postage.\n+ M2 mounting holes\n+ Optional power resisotrs\n+ Optional regulator for typical automotive power\n+ Optional pin header for breadboard etc. \n+ Could cut at pin header for direct PCB mount by castellation\n2021424:\nGoal: Give left 6 passive components space from the left edge & the DIP\nMove signal trace away from right edge. Only traces by edge are GND.\nMove 5 passive components on the right slightly closer to edge.\nMove IC, DIP & hidden cap slightly right. Extend board edge slightly left.\nEnsure all traces are at least 0.2mm. Tidy left 6 passive comonents & reroute.\nEnsure GND plane encircles all with a via in each corner.\n"
		(at 93.98 154.94 0)
		(layer "Cmts.User")
		(uuid "f3467935-70e7-49ca-93b0-fb77bcd6e130")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
			)
			(justify left)
		)
	)
